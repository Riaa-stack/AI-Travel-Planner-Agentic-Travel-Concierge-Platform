# Root .gitignore for AI Travel Planner Platform

# Environment variables
.env
.env.*
!.env.example
Frontend/.env
Backend/.env

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
Frontend/node_modules/
Frontend/dist/
Frontend/build/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
Backend/__pycache__/
Backend/app/**/__pycache__/
Backend/venv/
Backend/.venv/
Backend/env/
venv/
.venv/
env/

# Flask & SQLite
instance/
*.sqlite
*.sqlite3
*.db

# Logs & Tests
*.log
.pytest_cache/
.coverage
htmlcov/

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db
