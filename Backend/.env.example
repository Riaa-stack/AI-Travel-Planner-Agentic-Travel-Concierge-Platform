# ==============================================================================
# AI Travel Planner - Backend Environment Configuration
# Copy this file to .env and fill in your own credentials/API keys
# ==============================================================================

# Flask Server Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=your_super_secret_session_key_here
JWT_SECRET_KEY=your_jwt_secret_signing_key_here

# Database Configuration
# Default PostgreSQL: postgresql://<username>:<password>@localhost:5432/<database_name>
DATABASE_URL=postgresql://postgres:password@localhost:5432/travel_planner_db

# Google Gemini AI (Required for agentic planning & itinerary orchestration)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_OUTPUT_TOKENS=16384

# Geoapify API (Required for geocoding, places, and map routing)
# Get your API key from: https://www.geoapify.com/
GEOAPIFY_API_KEY=your_geoapify_api_key_here

# OpenWeather API (Required for destination weather forecasting)
# Get your API key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Optional Hotel API
HOTEL_API_KEY=your_hotel_api_key_here
